{
  "appId": "com.goalos.app",
  "productName": "GoalOS",
  "copyright": "Copyright © 2026 GoalOS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "package.json"
  ],
  "protocols": [
    {
      "name": "GoalOS Protocol",
      "schemes": ["goalos"]
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GoalOS"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "icon": "assets/icon.png"
  },
  "publish": {
    "provider": "github",
    "owner": "goalos",
    "repo": "goalos"
  }
}
