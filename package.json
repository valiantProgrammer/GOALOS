{
  "name": "goalos-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @goalos/web dev",
    "dev:desktop": "pnpm --filter @goalos/desktop dev",
    "dev:mobile": "pnpm --filter @goalos/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:core": "pnpm --filter @goalos/core test",
    "test:e2e": "pnpm --filter @goalos/web test:e2e",
    "seed:demo": "pnpm --filter @goalos/web seed:demo",
    "shots": "pnpm --filter @goalos/web shots",
    "slice:mockups": "python scripts/slice_mockups.py"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.22.0"
}
